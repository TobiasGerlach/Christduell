APP_NAME="Christduell API"
ENVIRONMENT=local
# SQLite locally; production uses the Postgres URL that Terraform injects.
DATABASE_URL=sqlite:///./christduell.db
# Run `alembic upgrade head` on startup. On Postgres this takes an advisory
# lock first, so overlapping instances queue instead of racing.
AUTO_MIGRATE=true
# Postgres connection pool (ignored on SQLite).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Auth -------------------------------------------------------------------
# Any non-local environment refuses to start with the built-in default.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Comma-separated browser origins allowed to call the API (Expo web build).
# Ignored locally, where every origin is allowed.
CORS_ORIGINS=

# --- Push notifications -----------------------------------------------------
# With PUSH_ENABLED=false the backend logs what it would have sent.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=
AZURE_NOTIFICATION_HUB_NAME=

# --- Research ---------------------------------------------------------------
# Master switch for the questionnaires. True locally so the flow can be
# developed; production keeps it false until the consent texts are approved.
RESEARCH_ENABLED=true

# --- Gameplay ----------------------------------------------------------------
# Days without a move before the maintenance job closes an open duel.
DUEL_INACTIVITY_EXPIRY_DAYS=3

# --- Billing ----------------------------------------------------------------
# none   — subscriptions off (checkout returns 503)
# fake   — local testing: checkout grants 30 days instantly (blocked outside local)
# stripe — real Stripe Checkout subscriptions
BILLING_PROVIDER=none
SUBSCRIPTION_PRICE_EUR=5.00
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=http://localhost:8081/billing/success
BILLING_CANCEL_URL=http://localhost:8081/billing/cancel
