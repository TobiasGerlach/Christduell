# Base URL of the Christduell backend. Inlined into the bundle at build time.
# Local development (default): http://localhost:8000
# Deployed:                    https://christduell-production-api.azurewebsites.net
EXPO_PUBLIC_API_URL=http://localhost:8000

# Links shown at registration. Without them the app shows neutral beta wording
# instead of claiming agreement to documents that do not exist. Set both before
# any public deployment.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
